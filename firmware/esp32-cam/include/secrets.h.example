// Copy this file to secrets.h and fill in your real values. secrets.h is
// gitignored - never commit real credentials.

#pragma once

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// The backend's /api/v1/frames endpoint. Use this machine's LAN IP for
// local dev (`ipconfig` on the machine running server/ to find
// it), or the deployed Render URL once that's live. Must include the
// path, not just the host.
#define SERVER_URL "http://192.168.1.34:8000/api/v1/frames"

// Must match the backend's API_AUTH_TOKEN (server/.env - auto-generated
// on first run, check the startup log, or set it explicitly - see
// the README's Backend > Configuration section).
#define API_AUTH_TOKEN ""

// MQTT broker for remote control and over-the-air updates. EMQX Cloud
// Serverless (free monthly quota, keep Spend Limit at 0): the deployment's
// Overview page shows the host (port 8883, TLS); create the username/password
// under Access Control -> Authentication. Leave MQTT_HOST empty to run
// without remote control.
#define MQTT_HOST     ""
#define MQTT_PORT     8883
#define MQTT_USERNAME ""
#define MQTT_PASSWORD ""
