# Copy to .env and fill in values from your Supabase project's
# Settings -> API page. See README.md's "Configuring Supabase" section -
# Option A (use the existing project) already has a working .env committed;
# this file is for Option B (a fresh project of your own).

SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

# Same three values again, VITE_-prefixed so Vite inlines them into the
# browser bundle at build time (see src/integrations/supabase/client.ts).
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
